rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Schools collection - only owner can read/write
    match /schools/{schoolId} {
      allow read, write: if request.auth.token.role == "owner";
    }

    // Students collection - only logged-in schools can read/write their own students
    match /students/{studentId} {
  allow read, write: if request.auth != null &&
                     request.auth.token.role == "school" &&
                     request.resource.data.schoolId == request.auth.uid;
}

  }
}
